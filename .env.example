# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Authentication ─────────────────────────────────────────────────────────────
# Replace with a long random string in production
JWT_SECRET=replace-with-a-secure-random-secret

# ── Storage ────────────────────────────────────────────────────────────────────
# Use 'memory' for local dev (no DB needed), 'postgres' for production
STORAGE_MODE=memory

# ── PostgreSQL (required when STORAGE_MODE=postgres) ──────────────────────────
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/nestmate_db

# ── Optional ───────────────────────────────────────────────────────────────────
PG_POOL_MAX=20
DEBUG_SQL=false
