# NestMate Backend Environment Configuration
PORT=3000
JWT_SECRET=nestmate-jwt-secret-for-demo

# Storage Mode: 'memory' for in-memory JSON fallback, 'postgres' for live PostgreSQL database
STORAGE_MODE=memory

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestmate_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestmate_test_db
PG_POOL_MAX=20
